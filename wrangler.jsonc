{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "agent-visibility-template",
	"account_id": "12295b17b80bd0637d3de1cc5f281b0c",
	"workers_dev": true,
	"routes": [
		{ "pattern": "katiebuilds.xyz", "custom_domain": true },
		{ "pattern": "www.katiebuilds.xyz", "custom_domain": true },
		{ "pattern": "katiecoinsbase.xyz", "custom_domain": true },
		{ "pattern": "www.katiecoinsbase.xyz", "custom_domain": true }
	],
	"main": "./src/worker/index.ts",
	"compatibility_date": "2025-10-08",
	"upload_source_maps": true,
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./dist/client",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/.well-known/web-bot-auth/*",
			"/api",
			"/api/*",
			"/index.json",
			"/jsonld",
			"/llms-full.txt",
			"/llms.txt",
			"/robots.txt",
			"/*.jsonld",
			"/*.md"
		]
	},
	"ai": {
		"binding": "AI"
	},
	"kv_namespaces": [
		{
			"binding": "VISIBILITY_CACHE",
			"id": "ab8c0444b68842989ee1fb1f00ddd2d8"
		}
	],
	"vars": {
		"SITE_NAME": "Katie Coins Base",
		"SITE_DESCRIPTION": "Home base for Katie Coins' crypto and web3 projects.",
		"AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
		"ENRICHMENT_CACHE_TTL": "3600",
		"CONTENT_SIGNAL": "ai-input=yes, search=yes, ai-train=no",
		"ENABLE_WEB_BOT_AUTH": "false"
	}
}
